# Cloudflare API configuration
cloudflare:
  # Your Cloudflare API token with Zone:DNS:Edit permissions.
  # Generate at: https://dash.cloudflare.com/profile/api-tokens
  # A single token can manage every zone the token has access to, so it is
  # used for all records below unless a record overrides it with its own
  # `apiToken`.
  apiToken: "your-cloudflare-api-token-here"

  # One or more DNS records to keep pointed at your current IP. Records may
  # live in different zones / different domains.
  records:
    - zoneId: "your-zone-id-here"        # Found in the Overview tab of the domain
      recordName: "home.example.com"     # The record to update
      recordType: "A"                    # "A" for IPv4, "AAAA" for IPv6

    # Add as many records as you like, in any zone:
    # - zoneId: "another-zone-id"
    #   recordName: "vpn.example.org"
    #   recordType: "A"
    #
    # - zoneId: "yet-another-zone-id"
    #   recordName: "ipv6.example.net"
    #   recordType: "AAAA"
    #   apiToken: "an-optional-per-record-token"   # overrides the token above

# IP monitoring settings
monitoring:
  # How often to check for IP changes (in seconds). Default: 300 (5 minutes).
  checkInterval: 300

  # How long to wait before retrying after a failed lookup (in seconds).
  retryInterval: 60

  # Maximum number of lookup attempts per check before giving up until the
  # next interval.
  maxRetries: 3

# Notifications
notifications:
  telegram:
    enabled: false
    botToken: "your-bot-token"
    chatId: "your-chat-id"
    # Supports {ip} and {record} placeholders.
    message: "IP address for {record} changed to: {ip}"

# Logging configuration
logging:
  # Log level (DEBUG, INFO, WARN, ERROR)
  level: "INFO"

  # Log file location (relative to the working directory)
  file: "logs/clouddnsync.log"

  # Maximum size of each log file before rotation
  maxSize: "10MB"

  # Number of rotated log files to keep
  maxBackups: 5
